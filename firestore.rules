rules_version = '2';

// Companion / mHealth RCT — Firestore security rules.
//
// Threat model: the only writer of user data is the authenticated user
// themselves; the global arm-balancing counter is the only doc outside
// the per-user scope. Server-side admin reads happen via service accounts
// which bypass these rules.
//
// Collections this app uses (Sprint 1 additions marked *new*):
//   users/{uid}                                  -> profile (incl. server-written arm, consent,
//                                                   close_contacts, interests,
//                                                   firstIntroSeen, per-agent
//                                                   transcript flags,
//                                                   *new* strataCell)
//   users/{uid}/events/{eventId}                 -> analytics events
//   users/{uid}/memory/{moduleId}/entries/{id}   -> legacy module summaries
//   users/{uid}/action_plans/{id}                -> M7 plans
//   users/{uid}/thought_records/{id}             -> legacy M4 records (read-only after Sprint 1)
//   users/{uid}/thought_exercise/entries/{id}    -> *new* B.4 expanded TE entries
//   users/{uid}/m3_reminiscence/...              -> M3 sessions
//   users/{uid}/agent_contexts/{agent_id}        -> per-agent context (Dev Req §4.2)
//   users/{uid}/shared_context/current           -> cross-agent shared state
//   users/{uid}/mem_*/{id}                       -> memory v1 (server-written; owner read/delete)
//   meta/memory_config                           -> memory v1 kill switch + policy (admin only)
//   app_config/usage_copy                        -> T20 usage-frequency copy (signed-in read, no client write)
//   users/{uid}/fcm_tokens/{deviceId}            -> *new* B.12 FCM push tokens
//   meta/arm_counter                             -> *new* 4-cell A/B balance counter
//   safety_events/{eventId}                      -> *new* B.7 distress events (client-write, admin-read)
//   safety_event_dedup/{dedupKey}                -> *new* B.7 dedup sentinel (admin-write only)
//   pi_alerts/{alertId}                          -> *new* B.7 acute alert queue (admin-write only)
//   llm_calls/{callId}                           -> C04 per-call model log (Cloud Functions only)
//   research_id_map/{uid}, research_ids/{rid}    -> T12 research-ID lookup (server-write; unblinded role read)
//   safety_classifier_calls/{id}                 -> T8 classifier call log (server; App adds own fallback rows only)
//   users/{uid}/djg_responses/{timepoint}        -> T18 W2 DJG (client: raw answers only; server: scores, push, missed)
//   users/{uid}/ada_responses/{timepoint}        -> T17 Phase A ADA (owner only; frozen once submitted)
//   users/{uid}/day7_open_responses/{timepoint}  -> T17 Phase A day-7 open questions (same rule)

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // T12 (decision 0021): roles are Auth custom claims set by
    // tool/provision_researcher.js.  role == 'pi' is the unblinded role;
    // role == 'researcher' is blinded.  Participants have no role.
    function isUnblinded() {
      return isAuthed() && request.auth.token.role == 'pi';
    }

    // ============================================================
    // Profile doc.  The owner reads and writes it, except the RCT
    // assignment fields, which only the assignArm Cloud Function
    // (admin SDK, bypasses rules) may write — decision 0003 / 0022:
    //   - create: `arm` and `strataCell` must be absent or null;
    //   - update: none of the assignment fields may change.  A
    //     merge-write that repeats the stored value (or omits it)
    //     changes nothing, so ordinary profile updates pass;
    //   - delete: never from a client.  Deleting and re-creating the
    //     doc would let assignArm re-randomise the participant.
    //     Whole-person deletion runs server-side (admin SDK).
    // ============================================================
    function assignmentFields() {
      return ['arm', 'strataCell', 'armAssignmentMode', 'armAssignedBy',
              'armAssignedAt'];
    }

    function createLeavesAssignmentEmpty(data) {
      return data.get('arm', null) == null
        && data.get('strataCell', null) == null
        && !data.keys().hasAny(['armAssignmentMode', 'armAssignedBy',
                                'armAssignedAt']);
    }

    function updateLeavesAssignmentUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(assignmentFields());
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && createLeavesAssignmentEmpty(request.resource.data);
      allow update: if isOwner(uid) && updateLeavesAssignmentUntouched();
      allow delete: if false;
    }

    // ============================================================
    // The owner reads/writes anything under their own user doc.
    // ============================================================
    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if isOwner(uid) && !collection.matches('mem_.*')
        && collection != 'djg_responses'
        && !(collection in phaseASurveyCollections());
    }

    // ============================================================
    // T18 (decision 0027) — W2 DJG, users/{uid}/djg_responses/W2.
    // The owner writes only the raw answers, status (in_progress →
    // submitted) and the start / submit times.  Scores, outsideWindow,
    // the window dates, push / reminder times and the missed mark are
    // written by Cloud Functions only (admin SDK).  Once submitted or
    // missed the doc is frozen for the client; no client deletes.
    // ============================================================
    function djgClientKeys() {
      return ['timepoint', 'itemsVersion', 'answers', 'status', 'startedAt',
              'startedAtLocal', 'submittedAt', 'submittedAtLocal',
              'updatedAt'];
    }

    function djgAnswerOk(a, k) {
      return !(k in a) || a[k] in ['yes', 'mostly', 'no', 'skipped'];
    }

    function djgValid(d) {
      return d.timepoint == 'W2'
        && d.status in ['in_progress', 'submitted']
        && d.answers is map
        && d.answers.keys().hasOnly(['q1', 'q2', 'q3', 'q4', 'q5', 'q6'])
        && djgAnswerOk(d.answers, 'q1') && djgAnswerOk(d.answers, 'q2')
        && djgAnswerOk(d.answers, 'q3') && djgAnswerOk(d.answers, 'q4')
        && djgAnswerOk(d.answers, 'q5') && djgAnswerOk(d.answers, 'q6')
        && (d.status == 'submitted'
              ? d.submittedAt == request.time
              : !('submittedAt' in d));
    }

    match /users/{uid}/djg_responses/{timepoint} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && timepoint == 'W2'
        && request.resource.data.keys().hasOnly(djgClientKeys())
        && djgValid(request.resource.data);
      allow update: if isOwner(uid)
        && resource.data.status in ['pending', 'in_progress']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(djgClientKeys())
        && djgValid(request.resource.data);
      allow delete: if false;
    }

    // ============================================================
    // T17 (decision 0026) — Phase A ADA and day-7 open questions.
    // One doc per timepoint, saved on every screen.  Only the owner
    // reads or writes it; the doc must carry the owner's uid and keep
    // its timepoint; once status is "submitted" it is frozen.  No
    // client deletes (whole-person deletion runs server-side).
    // ============================================================
    function phaseASurveyCollections() {
      return ['ada_responses', 'day7_open_responses'];
    }

    function validPhaseASurvey(docId) {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.timepoint == docId
        && request.resource.data.status in ['in_progress', 'submitted'];
    }

    match /users/{uid}/ada_responses/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validPhaseASurvey(docId);
      allow update: if isOwner(uid) && validPhaseASurvey(docId)
        && resource.data.status == 'in_progress';
      allow delete: if false;
    }
    match /users/{uid}/day7_open_responses/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validPhaseASurvey(docId);
      allow update: if isOwner(uid) && validPhaseASurvey(docId)
        && resource.data.status == 'in_progress';
      allow delete: if false;
    }

    // ============================================================
    // Memory v1 (functions/memory.js is the only writer).  The owner
    // may read and delete their memory items — the 「我記得嘅嘢」 page —
    // and confirm a sensitive item (pending_confirmation → active,
    // nothing else changed).  They can never create or edit content,
    // so an agent can't be fed fabricated memories.  Injection logs
    // and extraction records are server-only.
    // ============================================================
    match /users/{uid}/mem_summaries/{id} {
      allow read, delete: if isOwner(uid);
    }
    match /users/{uid}/mem_followups/{id} {
      allow read, delete: if isOwner(uid);
    }
    match /users/{uid}/mem_facts/{id} {
      allow read, delete: if isOwner(uid);
      allow update: if isOwner(uid)
        && resource.data.status == 'pending_confirmation'
        && request.resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status']);
    }
    match /users/{uid}/mem_injections/{id} {
      allow read, write: if false;
    }
    match /users/{uid}/mem_extractions/{id} {
      allow read, write: if false;
    }

    // ============================================================
    // B.7 safety_events — client can create its own events only.
    // No client reads, no updates, no deletes.  The onCreate Cloud
    // Function trigger runs as a service account (bypasses rules)
    // and patches the doc with dedup_key.
    // ============================================================
    // Phase A baseline — runtime parameters (PhaseAConfig).  Clients read,
    // never write; the research team edits from the console.  Also holds
    // app_config/usage_copy (T20, usage-frequency copy, both arms).
    match /app_config/{doc} {
      allow read: if isAuthed();
      allow write: if false;
    }

    match /safety_events/{eventId} {
      allow create: if isAuthed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'source', 'textHash', 'level'])
        && request.resource.data.level in ['none', 'low', 'moderate',
            'moderate_review', 'moderate_interrupt', 'acute']
        // T7: source is one of the three analysis buckets; the pre-T7
        // codes stay valid so an old build's events are not lost.
        && request.resource.data.source in ['user_input', 'ai_output_scan',
            'form', 'gateway_input', 'gateway_output', 'm3_turn', 'rule_turn']
        // Dedup / escalation fields are the trigger's, never the client's.
        && !request.resource.data.keys().hasAny(['dedup_key', 'isDuplicate',
            'duplicateOf', 'escalatedBy']);
      // Reads + updates come only from service accounts.
      allow read, update, delete: if false;
    }

    // T7 hotline outbound filter log — Cloud Functions only (no text).
    match /hotline_filter_log/{id} {
      allow read, write: if false;
    }

    // T8 safety-classifier call log (decision 0025, proposed).  The
    // classifySafety Cloud Function writes a row for every call it relays
    // (admin SDK).  The App may only add its own fallback rows — calls
    // whose answer never came back — with a fixed set of fields and no
    // text.  No client reads, updates or deletes.
    match /safety_classifier_calls/{id} {
      allow create: if isAuthed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.writer == 'app'
        && request.resource.data.status in ['client_timeout', 'client_error']
        && request.resource.data.keys().hasOnly(['uid', 'writer', 'status',
            'input_point', 'source', 'turn_id', 'latency_ms', 'ts']);
      allow read, update, delete: if false;
    }

    // ============================================================
    // B.7 dedup sentinels and PI alert queue — admin-write only.
    // Clients must not read or write these collections.
    // ============================================================
    match /safety_event_dedup/{dedupKey} {
      allow read, write: if false;
    }
    match /pi_alerts/{alertId} {
      allow read, write: if false;
    }

    // ============================================================
    // B.5 Thought-Exercise audit queue — admin-only.  Written by the
    // onThoughtExerciseCreated CF; read by the researcher dashboard
    // via a service account (Sprint 3 B.13).
    // ============================================================
    match /te_audit_queue/{auditId} {
      allow read, write: if false;
    }

    // ============================================================
    // C.1 Weekly loneliness probe queue — admin-write only.  The
    // weekly cron writes per-user pending probes; client reads its
    // own pending probe under users/{uid}/... (handled by the
    // wildcard owner rule above).  The top-level mirror is admin-only.
    // ============================================================
    match /pending_loneliness_probes/{uid} {
      allow read, write: if false;
    }

    // ============================================================
    // C.4 Blinded export keys — PI service account only.  Working
    // analysts must NEVER read this collection or blinding fails.
    // ============================================================
    match /export_blind_keys/{dateKey} {
      allow read, write: if false;
    }

    // ============================================================
    // C04 model log — one doc per DeepSeek call, written by Cloud
    // Functions (functions/llm_log.js).  Clients never read or write.
    // ============================================================
    match /llm_calls/{callId} {
      allow read, write: if false;
    }

    // ============================================================
    // T12 research IDs (functions/blinding.js is the only writer).
    // The uid <-> research ID lookup de-pseudonymises the blinded
    // export, so only the unblinded role may read it; nobody writes
    // from a client.  meta/blinding_config has no rule: admin only.
    // ============================================================
    match /research_id_map/{uid} {
      allow read: if isUnblinded();
      allow write: if false;
    }
    match /research_ids/{researchId} {
      allow read: if isUnblinded();
      allow write: if false;
    }

    // ============================================================
    // C.2 stratified RCT arm-balance counter (Sprint 1.4).
    //
    // Schema: { cell_0: {aCount, bCount}, cell_1: ..., cell_2: ...,
    //           cell_3: ..., updatedAt }
    //
    // Invariant per cell: each individual cell's (aCount, bCount)
    // may each increment by at most 1 per write, and neither may
    // decrease.  Exactly one cell must change; the other three must
    // be untouched.
    //
    // This is the highest-concurrency write surface in the system
    // (concurrent signups); keep the rule tight.
    // ============================================================
    match /meta/arm_counter {
      // T12: per-arm counts are unblinding information.  The app no
      // longer reads this doc (assignArm runs on the server), so only
      // the unblinded role may.
      allow read: if isUnblinded();

      // Written as per-count deltas: the previous nested-helper form
      // (cellPrior/cellNext/validIncrement/cellUnchanged over 4 × 4
      // alternatives) exceeded the rules engine's 1,000-expression limit
      // and DENIED every legitimate increment, including the first write.
      // Missing cells / counts read as 0 via map.get defaults.
      function count(data, cell, key) {
        return data.get(cell, {}).get(key, 0);
      }
      function delta(cell, key) {
        return count(request.resource.data, cell, key)
             - count(resource == null ? {} : resource.data, cell, key);
      }

      // No count may decrease, and exactly one count across all four
      // cells rises by exactly 1 (so one cell changes, the rest don't).
      allow create, update: if isAuthed()
        && delta('cell_0', 'aCount') >= 0 && delta('cell_0', 'bCount') >= 0
        && delta('cell_1', 'aCount') >= 0 && delta('cell_1', 'bCount') >= 0
        && delta('cell_2', 'aCount') >= 0 && delta('cell_2', 'bCount') >= 0
        && delta('cell_3', 'aCount') >= 0 && delta('cell_3', 'bCount') >= 0
        && delta('cell_0', 'aCount') + delta('cell_0', 'bCount')
         + delta('cell_1', 'aCount') + delta('cell_1', 'bCount')
         + delta('cell_2', 'aCount') + delta('cell_2', 'bCount')
         + delta('cell_3', 'aCount') + delta('cell_3', 'bCount') == 1;
    }

    // Everything else is denied by default.
  }
}
