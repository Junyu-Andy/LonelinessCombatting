rules_version = '2';

// Companion / mHealth RCT — Firestore security rules.
//
// Threat model: the only writer of user data is the authenticated user
// themselves; the global arm-balancing counter is the only doc outside
// the per-user scope. Server-side admin reads happen via service accounts
// which bypass these rules.
//
// Collections this app uses (Sprint 1 additions marked *new*):
//   users/{uid}                                  -> profile (incl. write-once arm, consent,
//                                                   close_contacts, interests,
//                                                   firstIntroSeen, per-agent
//                                                   transcript flags,
//                                                   *new* strataCell)
//   users/{uid}/events/{eventId}                 -> analytics events
//   users/{uid}/memory/{moduleId}/entries/{id}   -> legacy module summaries
//   users/{uid}/action_plans/{id}                -> M7 plans
//   users/{uid}/thought_records/{id}             -> legacy M4 records (read-only after Sprint 1)
//   users/{uid}/thought_exercise/entries/{id}    -> *new* B.4 expanded TE entries
//   users/{uid}/m3_reminiscence/...              -> M3 sessions
//   users/{uid}/agent_contexts/{agent_id}        -> per-agent context (Dev Req §4.2)
//   users/{uid}/shared_context/current           -> cross-agent shared state
//   users/{uid}/mem_*/{id}                       -> memory v1 (server-written; owner read/delete)
//   meta/memory_config                           -> memory v1 kill switch + policy (admin only)
//   users/{uid}/fcm_tokens/{deviceId}            -> *new* B.12 FCM push tokens
//   meta/arm_counter                             -> *new* 4-cell A/B balance counter
//   safety_events/{eventId}                      -> *new* B.7 distress events (client-write, admin-read)
//   safety_event_dedup/{dedupKey}                -> *new* B.7 dedup sentinel (admin-write only)
//   pi_alerts/{alertId}                          -> *new* B.7 acute alert queue (admin-write only)
//   llm_calls/{callId}                           -> C04 per-call model log (Cloud Functions only)

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // ============================================================
    // Profile doc.  The owner reads/writes it, except that the RCT
    // arm is write-once: it may go from absent/null to 'A' or 'B'
    // (signup, or the arm==null backfill) and never change after.
    // A merge-write that omits `arm` keeps the stored value, so
    // ordinary profile updates pass.
    // ============================================================
    function armValid(data) {
      return data.get('arm', null) == null || data.arm in ['A', 'B'];
    }

    // Written only by the assignArm Cloud Function. armAssignmentMode
    // also decides who gets mandatory memory v1 (Phase B Arm A), so a
    // client must never set or change these.
    function serverAssignmentUntouched() {
      return !request.resource.data.diff(
          resource == null ? {} : resource.data).affectedKeys()
        .hasAny(['armAssignmentMode', 'armAssignedBy', 'armAssignedAt']);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && armValid(request.resource.data)
        && serverAssignmentUntouched();
      allow update: if isOwner(uid)
        && armValid(request.resource.data)
        && serverAssignmentUntouched()
        && (resource.data.get('arm', null) == null
            || request.resource.data.get('arm', null) == resource.data.arm);
    }

    // ============================================================
    // The owner reads/writes anything under their own user doc.
    // ============================================================
    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if isOwner(uid) && !collection.matches('mem_.*');
    }

    // ============================================================
    // Memory v1 (functions/memory.js is the only writer).  The owner
    // may read and delete their memory items — the 「我記得嘅嘢」 page —
    // and confirm a sensitive item (pending_confirmation → active,
    // nothing else changed).  They can never create or edit content,
    // so an agent can't be fed fabricated memories.  Injection logs
    // and extraction records are server-only.
    // ============================================================
    match /users/{uid}/mem_summaries/{id} {
      allow read, delete: if isOwner(uid);
    }
    match /users/{uid}/mem_followups/{id} {
      allow read, delete: if isOwner(uid);
    }
    match /users/{uid}/mem_facts/{id} {
      allow read, delete: if isOwner(uid);
      allow update: if isOwner(uid)
        && resource.data.status == 'pending_confirmation'
        && request.resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status']);
    }
    match /users/{uid}/mem_injections/{id} {
      allow read, write: if false;
    }
    match /users/{uid}/mem_extractions/{id} {
      allow read, write: if false;
    }

    // ============================================================
    // B.7 safety_events — client can create its own events only.
    // No client reads, no updates, no deletes.  The onCreate Cloud
    // Function trigger runs as a service account (bypasses rules)
    // and patches the doc with dedup_key.
    // ============================================================
    // Phase A baseline — runtime parameters (PhaseAConfig).  Clients read,
    // never write; the research team edits from the console.
    match /app_config/{doc} {
      allow read: if isAuthed();
      allow write: if false;
    }

    match /safety_events/{eventId} {
      allow create: if isAuthed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'source', 'textHash', 'level'])
        && request.resource.data.level in ['none', 'low', 'moderate',
            'moderate_review', 'moderate_interrupt', 'acute'];
      // Reads + updates come only from service accounts.
      allow read, update, delete: if false;
    }

    // ============================================================
    // B.7 dedup sentinels and PI alert queue — admin-write only.
    // Clients must not read or write these collections.
    // ============================================================
    match /safety_event_dedup/{dedupKey} {
      allow read, write: if false;
    }
    match /pi_alerts/{alertId} {
      allow read, write: if false;
    }

    // ============================================================
    // B.5 Thought-Exercise audit queue — admin-only.  Written by the
    // onThoughtExerciseCreated CF; read by the researcher dashboard
    // via a service account (Sprint 3 B.13).
    // ============================================================
    match /te_audit_queue/{auditId} {
      allow read, write: if false;
    }

    // ============================================================
    // C.1 Weekly loneliness probe queue — admin-write only.  The
    // weekly cron writes per-user pending probes; client reads its
    // own pending probe under users/{uid}/... (handled by the
    // wildcard owner rule above).  The top-level mirror is admin-only.
    // ============================================================
    match /pending_loneliness_probes/{uid} {
      allow read, write: if false;
    }

    // ============================================================
    // C.4 Blinded export keys — PI service account only.  Working
    // analysts must NEVER read this collection or blinding fails.
    // ============================================================
    match /export_blind_keys/{dateKey} {
      allow read, write: if false;
    }

    // ============================================================
    // C04 model log — one doc per DeepSeek call, written by Cloud
    // Functions (functions/llm_log.js).  Clients never read or write.
    // ============================================================
    match /llm_calls/{callId} {
      allow read, write: if false;
    }

    // ============================================================
    // C.2 stratified RCT arm-balance counter (Sprint 1.4).
    //
    // Schema: { cell_0: {aCount, bCount}, cell_1: ..., cell_2: ...,
    //           cell_3: ..., updatedAt }
    //
    // Invariant per cell: each individual cell's (aCount, bCount)
    // may each increment by at most 1 per write, and neither may
    // decrease.  Exactly one cell must change; the other three must
    // be untouched.
    //
    // This is the highest-concurrency write surface in the system
    // (concurrent signups); keep the rule tight.
    // ============================================================
    match /meta/arm_counter {
      allow read: if isAuthed();

      // Written as per-count deltas: the previous nested-helper form
      // (cellPrior/cellNext/validIncrement/cellUnchanged over 4 × 4
      // alternatives) exceeded the rules engine's 1,000-expression limit
      // and DENIED every legitimate increment, including the first write.
      // Missing cells / counts read as 0 via map.get defaults.
      function count(data, cell, key) {
        return data.get(cell, {}).get(key, 0);
      }
      function delta(cell, key) {
        return count(request.resource.data, cell, key)
             - count(resource == null ? {} : resource.data, cell, key);
      }

      // No count may decrease, and exactly one count across all four
      // cells rises by exactly 1 (so one cell changes, the rest don't).
      allow create, update: if isAuthed()
        && delta('cell_0', 'aCount') >= 0 && delta('cell_0', 'bCount') >= 0
        && delta('cell_1', 'aCount') >= 0 && delta('cell_1', 'bCount') >= 0
        && delta('cell_2', 'aCount') >= 0 && delta('cell_2', 'bCount') >= 0
        && delta('cell_3', 'aCount') >= 0 && delta('cell_3', 'bCount') >= 0
        && delta('cell_0', 'aCount') + delta('cell_0', 'bCount')
         + delta('cell_1', 'aCount') + delta('cell_1', 'bCount')
         + delta('cell_2', 'aCount') + delta('cell_2', 'bCount')
         + delta('cell_3', 'aCount') + delta('cell_3', 'bCount') == 1;
    }

    // Everything else is denied by default.
  }
}
